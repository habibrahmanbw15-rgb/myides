generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Idea {
  id        String   @id @default(uuid())
  title     String
  platforms String
  status    String   @default("Draft")
  pillar    String?
  notes     String?
  createdAt DateTime @default(now())
}