generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Idea {
  id        String   @id @default(uuid()) // atau Int @id @default(autoincrement())
  title     String
  platforms String // Disimpan sebagai stringified JSON
  status    String   @default("Draft")
  pillar    String?
  notes     String?
  createdAt DateTime @default(now())
}
